<!--
  sbobctl generated enforcement-telemetry rule — workload: php-fpm
  workload: php-fpm
  generated by sbobctl (do not edit by hand; regenerate from the pinned SBoB)
  fires on /var/ossec/logs/sbob-enforce.log (json localfile, php-fpm-enforce-localfile.xml)
-->

<group name="sbob,php-fpm">
  <!-- enforcement (11,1) — requires the php-fpm-enforce-localfile.xml ingestion (json format, TDS 14.6) -->
  <rule  id="100211" level="10">
    <field name="sbob_workload" type="pcre2">^php-fpm$</field>
    <field name="action" type="pcre2">^process-kill(?:-revert|-failed)?$|^firewall-drop$</field>
    <group>sbob,php-fpm,sbob-enforce</group>
    <description>SBoB enforcement: active response executed for workload php-fpm (process-kill / firewall-drop telemetry — the block event itself, TDS 14.6)</description>
  </rule>
</group>
